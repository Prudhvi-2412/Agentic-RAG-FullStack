# Supabase project credentials (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Base URL of the FastAPI backend. A bare host (no scheme) is also accepted and
# resolved to https:// at runtime, which is what Render's fromService injection provides.
VITE_BACKEND_URL=http://localhost:8000
