# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=documind

# ── Supabase ──────────────────────────────────────────────────────────────────
# The backend verifies every access token's signature before trusting the user id it
# carries, so at least ONE of the two settings below is required. Startup fails otherwise.
#
# Supabase signs tokens one of two ways depending on the project:
#   1. Legacy shared HS256 secret  -> set SUPABASE_JWT_SECRET
#      Dashboard → Project Settings → API → JWT Settings → JWT Secret (or "Legacy JWT Secret")
#   2. Asymmetric signing keys     -> set SUPABASE_URL (the backend fetches the project JWKS)
#      Dashboard → Project Settings → API → JWT Keys (shows ECC/RSA "Current key")
# Setting both is safe: each token is verified with the source matching its own algorithm.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_URL=https://your-project.supabase.co
# Expected 'aud' claim; leave as-is unless you have customised Supabase auth.
SUPABASE_JWT_AUDIENCE=authenticated

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:5173

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_TTS_CHARS=5000
