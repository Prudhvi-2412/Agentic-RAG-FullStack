# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=documind

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret.
# Required: the backend verifies every access token's signature with it before trusting
# the user id it contains. Without it the server cannot enforce document ownership.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Expected 'aud' claim; leave as-is unless you have customised Supabase auth.
SUPABASE_JWT_AUDIENCE=authenticated

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:5173

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_TTS_CHARS=5000
