# ── Credentials & Secrets ────────────────────────────────────────────────────
.env
*.env
.env.*
# Allow the example templates to be committed. (Git has no trailing comments in ignore
# patterns — a comment on this line would become part of the pattern and silently break it.)
!.env.example
!**/.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.ipynb_checkpoints

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.npm
.eslintcache

# ── Operating System ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

